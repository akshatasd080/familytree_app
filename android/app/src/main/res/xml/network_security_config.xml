<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext only when backend is still on HTTP (LAN / staging).
     For production HTTPS APIs this is unused; prefer https:// base URL. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
